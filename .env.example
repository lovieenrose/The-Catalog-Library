# ==============================================================================
# The Cat-alog Library - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# NEVER commit the actual .env file with secrets into version control.
# ==============================================================================

# Application Environment (production, development, testing)
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost:8888
APP_SECRET=change_this_to_a_random_32_character_secret

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=8889
DB_NAME=the-catalog-library
DB_USER=root
DB_PASS=root
# Optional Unix socket (preferred on local MAMP/macOS if port is blocked)
DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock
# Optional SSL configuration for managed databases (e.g. AWS RDS, PlanetScale, Aiven)
DB_SSL_CA=
DB_SSL_VERIFY=true

# Session Storage Driver
# - 'file': Standard PHP session files on local disk (default for VPS, MAMP, Docker)
# - 'database': Shared persistent sessions in MySQL 'sessions' table (required for Vercel/serverless)
SESSION_DRIVER=file

# File Storage Driver
# - 'local': Saves book images in uploads/book-images/ (default for VPS, MAMP, Docker)
# - 's3': S3-compatible cloud object storage (AWS, Cloudflare R2, MinIO)
# - 'cloudinary': Cloudinary media hosting
STORAGE_DRIVER=local

# Cloud Object Storage (when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_KEY=
S3_SECRET=
S3_ENDPOINT=
S3_PUBLIC_URL=

# Password Reset & Email Notifications
# If MAIL_ENABLED=false, the password reset endpoint will safely inform users
# that resets must be handled by a library administrator.
MAIL_ENABLED=false
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@the-catalog-library.local
MAIL_FROM_NAME="The Cat-alog Library"

