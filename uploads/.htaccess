# Prevent script execution inside uploads directory
<FilesMatch "(?i)\.(php|phtml|phar|pl|py|cgi|sh|bash|exe|js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Only serve static images
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .phar
RemoveType .php .phtml .phar
php_flag engine off

